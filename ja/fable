#!/usr/bin/env bash
# fable — オーケストレーション層のトグル (Git Bash / Windows、コピー方式)
#
# 設定の本体は ~/.claude/fable/ にだけ置き、Claude Code が読む各設定ファイルには
# そのフォルダを指す薄いローディングコードだけを置く。トグルは状態ファイルを
# 書き換え、active.md をコピーで差し替える。
#
# シンボリックリンクを使わない理由: Windows でのシンボリックリンク作成は
# SeCreateSymbolicLinkPrivilege(管理者または開発者モード)が必要で、
# Git Bash の ln -s は権限がないとエラーではなく黙ってコピーを作ってしまうため
# (MSYS の既定動作)、トグルできているように見えて実際には切り替わらない状態になる。
# 最初からコピーだと明示すれば、この罠がなくなる。
#
#   fable on      次のセッションからオーケストレーション有効
#   fable off     次のセッションから通常モード
#   fable status  現在の状態 + ローディングコードの設置状況を点検
#   fable model [役割=モデル ...]   役割ごとのモデルを確認/変更
#                 役割: executor | reasoner | runner
#                 モデル: fable | opus | sonnet | haiku | claude- で始まる完全な ID
#
# このスクリプトは env.sh の fable() 関数が呼び出す。PATH に入れる必要はない。

set -u

BASE="$HOME/.claude/fable"
SWITCH="$HOME/.claude/.fable-state"

mark() { [ "$1" = 0 ] && printf '[OK]' || printf '[--]'; }

case "${1:-status}" in
  on)
    printf 'on\n' > "$SWITCH"
    cp -f "$BASE/instructions.md" "$BASE/active.md"
    echo "fable: ON — 次に起動する claude セッションから適用されます。"
    ;;
  off)
    printf 'off\n' > "$SWITCH"
    cp -f "$BASE/blank.md" "$BASE/active.md"
    echo "fable: OFF — 次に起動する claude セッションから通常モードです。"
    ;;
  status)
    state=$(cat "$SWITCH" 2>/dev/null || echo off)
    echo "fable オーケストレーション: $(echo "$state" | tr '[:lower:]' '[:upper:]')"

    if [ -f "$BASE/active.md" ]; then
      if head -n1 "$BASE/active.md" | grep -q 'fable off'; then
        echo "  active.md = blank.md のコピー (off)"
      else
        echo "  active.md = instructions.md のコピー (on)"
      fi
    else
      echo "  active.md = (未設置)"
    fi

    grep -q 'fable[\\/]active\.md' "$HOME/.claude/CLAUDE.md" 2>/dev/null; r1=$?
    echo "  $(mark $r1) CLAUDE.md インポート"

    { [ -f "$HOME/.claude/agents/executor.md" ] && \
      [ -f "$HOME/.claude/agents/deep-reasoner.md" ] && \
      [ -f "$HOME/.claude/agents/runner.md" ]; }; r2=$?
    echo "  $(mark $r2) エージェントのコピー 3 個 (~/.claude/agents/)"

    grep -q 'fable/env.sh' "$HOME/.bashrc" 2>/dev/null; r3=$?
    echo "  $(mark $r3) シェルローダー (~/.bashrc)"

    grep -q 'orchestration-gate' "$HOME/.claude/settings.json" 2>/dev/null; r4=$?
    echo "  $(mark $r4) ゲートフックの登録 (settings.json)"

    [ -f "$BASE/hooks/orchestration-gate.py" ]; r5=$?
    echo "  $(mark $r5) ゲートスクリプトの存在"

    command -v python >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; r6=$?
    echo "  $(mark $r6) python 実行ファイル (PATH)"
    ;;
  model)
    shift
    if [ $# -eq 0 ]; then
      echo "役割ごとのモデル (本体基準):"
      for a in executor deep-reasoner runner; do
        printf '  %-13s %s\n' "$a" "$(sed -n 's/^model: *//p' "$BASE/agents/$a.md" 2>/dev/null || echo '(未設置)')"
      done
      exit 0
    fi
    for pair in "$@"; do
      role="${pair%%=*}"; want="${pair#*=}"
      case "$role" in
        executor)               f=executor ;;
        reasoner|deep-reasoner) f=deep-reasoner ;;
        runner)                 f=runner ;;
        *) echo "不明な役割: $role (executor | reasoner | runner)" >&2; exit 1 ;;
      esac
      case "$want" in
        fable)    id=claude-fable-5 ;;
        opus)     id=claude-opus-5 ;;
        sonnet)   id=claude-sonnet-5 ;;
        haiku)    id=claude-haiku-4-5-20251001 ;;
        claude-*) id=$want ;;
        *) echo "不明なモデル: $want (fable | opus | sonnet | haiku | claude-...)" >&2; exit 1 ;;
      esac
      # macOS(BSD sed)は -i の引数規則が異なるため一時ファイルで処理する
      sed "s/^model:.*/model: $id/" "$BASE/agents/$f.md" > "$BASE/agents/$f.md.tmp" \
        && mv "$BASE/agents/$f.md.tmp" "$BASE/agents/$f.md"
      cp -f "$BASE/agents/$f.md" "$HOME/.claude/agents/$f.md"
      echo "  $f -> $id"
    done
    echo "次に起動する claude セッションから適用されます。"
    ;;
  *)
    echo "使い方: fable on | off | status | model [役割=モデル ...]" >&2
    exit 1
    ;;
esac
